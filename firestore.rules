rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 只有這兩個已驗證 Email 的 Google 帳號可存取
    function isTripMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'wx9950a@gmail.com',
          'coolyi19860311@gmail.com'
        ];
    }

    // 帳本、打包清單、行程備註都放在這個路徑底下
    match /artifacts/roy-ian-kobe-trip-2027/public/data/{document=**} {
      allow read: if isTripMember();
      allow write: if isTripMember();
    }

    // 其餘一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
